# DogVita CRM — environment variables
# Copy to .env.local and fill in. For v1 (mock data) nothing is required.

# Supabase (used after the Phase-1 swap from mock → live data)
# NEXT_PUBLIC_SUPABASE_URL=https://bxvihftrfamglqrilkok.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role — SERVER ONLY. Never expose in the browser.
# SUPABASE_SERVICE_ROLE_KEY=

# Operator session (mock auth in v1; replaced by Supabase Auth in Phase 1)
# OPERATOR_SESSION_SECRET=
