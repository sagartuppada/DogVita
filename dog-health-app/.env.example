# Supabase (required)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Fallback (for backward compat with EXPO_PUBLIC_ prefix)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# API (optional — custom backend)
EXPO_PUBLIC_API_URL=https://api.doghealthapp.com

# BLE Service UUIDs (ESP32-S3 Dog Collar)
EXPO_PUBLIC_BLE_SERVICE_UUID=12345678-1234-1234-1234-123456789abc
EXPO_PUBLIC_BLE_HEART_RATE_UUID=180d
EXPO_PUBLIC_BLE_GPS_UUID=12345678-1234-1234-1234-123456789001
EXPO_PUBLIC_BLE_TEMPERATURE_UUID=12345678-1234-1234-1234-123456789002
EXPO_PUBLIC_BLE_BATTERY_UUID=12345678-1234-1234-1234-123456789003
EXPO_PUBLIC_BLE_ACTIVITY_UUID=12345678-1234-1234-1234-123456789004

# App Configuration
EXPO_PUBLIC_APP_VERSION=1.0.0
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE
EXPO_PUBLIC_GEOFENCE_RADIUS_METERS=100
EXPO_PUBLIC_GPS_UPDATE_INTERVAL_MS=5000
EXPO_PUBLIC_HEART_RATE_ALERT_THRESHOLD=180
EXPO_PUBLIC_LOW_BATTERY_THRESHOLD=20
